{
  "name": "@omnidotdev/runa-mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Model Context Protocol server for Runa: list projects, columns, and tasks, read tasks with their comments, and create, update, move, and comment on tasks through the Runa API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnidotdev/runa-mcp.git"
  },
  "type": "module",
  "bin": {
    "runa-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "start:http": "bun run src/http.ts",
    "build": "bun build src/index.ts --target node --outfile dist/index.js --banner '#!/usr/bin/env node'",
    "check": "biome check --diagnostic-level=error src test",
    "format": "biome format --write src test",
    "lint": "biome lint --write src test",
    "typecheck": "tsc --noEmit",
    "knip": "knip-bun",
    "test": "bun test",
    "changeset": "changeset",
    "release": "bun run build && changeset publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fractional-indexing": "4.0.0",
    "graphql": "16.15.0",
    "graphql-request": "7.4.0",
    "jose": "6.2.18",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "1.4.5",
    "knip": "5.88.1",
    "typescript": "5.9.3"
  }
}
