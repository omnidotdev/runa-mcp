# Runa API base URL. Defaults to the public endpoint when unset.
RUNA_API_URL=https://api.runa.omni.dev

# Runa workspace API token (runa_...), created in a workspace's settings under
# API tokens. Without it the server still starts, but every tool returns a clear
# error explaining the credential is missing (startup-warning convention: warn +
# degrade).
RUNA_API_TOKEN=

# Hosted HTTP mode only (`bun run start:http`). Each client signs in through the
# browser (MCP authorization) or sends its own Runa API token as
# `Authorization: Bearer <token>`; RUNA_API_TOKEN is not read in this mode.
PORT=3000
HOST=0.0.0.0

# Hosted HTTP mode: MCP authorization (browser sign-in). Defaults target the
# hosted server and Gatekeeper; override only when self-hosting.
# MCP_RESOURCE_URL=https://mcp.runa.omni.dev
# AUTH_ISSUER=https://identity.omni.dev
# AUTH_JWKS_URL=https://identity.omni.dev/jwks
# AUTH_USERINFO_URL=https://identity.omni.dev/oauth2/userinfo
# GATEKEEPER_CLAIMS_NAMESPACE=https://manifold.omni.dev/@omni/claims
